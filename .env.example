# cp .env.example .env
DATABASE_URL=postgresql://analyst:analyst@localhost:5432/vacancies
# тестовая база очищается перед каждым тестом, не указывай рабочую
TEST_DATABASE_URL=postgresql://analyst:analyst@localhost:5432/vacancies_test

# fixtures (без сети) или api
DATA_SOURCE=fixtures
# «сегодня» для фикстур, чтобы результат был одинаковый
FIXTURE_NOW=2026-10-30

# для api: hh.ru просит User-Agent с контактом
HH_USER_AGENT=JobAnalysis/0.1 (your-email@example.com)
# без токена hh.ru отвечает 403
HH_ACCESS_TOKEN=
# пауза между запросами, сек
HH_REQUEST_DELAY=0.5

LOG_LEVEL=INFO
